# copy to .env (never commit .env)
MONGO_USER=azmoon
MONGO_PASS=change-me-to-a-long-random-password
# 32+ random characters, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# SMS for phone login: kavenegar (needs an API key and an approved template with %token%)
SMS_PROVIDER=kavenegar
SMS_API_KEY=
SMS_TEMPLATE=azmoonrep-otp
# 1 = students may still use username/password (during the move to phone login)
PASSWORD_LOGIN_FOR_STUDENTS=0
WEB_PORT=8080
